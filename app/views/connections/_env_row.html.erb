<%# One env of a project: which env and how careful it is, whether it can be
    written and how, then what this machine knows of its Kong node. Only rows
    Kongsole owns (local) can be edited or removed here. %>
<%# R5.7: the project page passes `overview_row` (ProjectOverview::Row) -- the
    row then adds what this machine last synced: counts, the sync time, a
    Trace link. The connections page passes nothing and stays as it was. %>
<% connection = env.kong_connection %>
<% overview = local_assigns[:overview_row] %>
<% synced = overview&.synced_at %>
<li class="row-card env-row<%= " env-row--empty" unless connection %><%= " env-row--overview" if overview && connection %>" data-env-name="<%= env.name %>">
  <div class="env-row__body">
    <div class="env-row__id">
      <%= env_name_chip(env) %>
      <%# A dev/sit/uat/prod chip already says how careful it is; only a chosen rank needs saying. %>
      <% if env.rank_kind == "other" %>
        <span class="env-row__rank"><%= rank_label(env) %></span>
      <% end %>
      <% if connection %>
        <%= status_badge(connection.last_status) %>
      <% end %>
    </div>

    <% if connection %>
      <%# One line, cut at the end: the host leads, and the full URL is in the title. %>
      <div class="env-row__url font-mono" title="<%= connection.admin_url %>"><%= connection.admin_url %></div>
      <% if overview && connection.last_status == "unreachable" %>
        <p class="env-row__alert">
          <%= t(env.project.network_note.present? ? "hints.pages.project_show.unreachable_html" : "hints.pages.project_show.unreachable_no_note_html",
                time: plan_timestamp(connection.last_connected_at) || "never") %>
        </p>
      <% end %>
    <% else %>
      <p class="env-row__note"><%= t("hints.pages.connections.env_without_connection") %></p>
    <% end %>

    <div class="env-row__tags">
      <%= write_policy_tag(env) %>
      <% if connection %>
        <% [ access_level_label(connection.access_level), credential_kind_label(connection.credential_kind) ].compact.each do |label| %>
          <span class="tag"><%= label %></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="env-row__actions">
    <% if connection %>
      <% if synced %>
        <%= link_to "Trace", project_trace_path(env.project.key, env: env.name), class: "btn-sm btn-text",
              aria: { label: "Trace a request on #{env.qualified_name}" } %>
      <% end %>
      <%= link_to "Log in", login_connection_path(connection), class: "btn-sm btn-secondary" %>
      <% if connection.editable_in_ui? %>
        <%# R1.15: the env (rank, apply mode, colour) and its connection (URL,
            TLS, credential) are edited apart -- two links, named for what
            each one edits. %>
        <%= link_to "Edit environment", edit_project_env_path(env), class: "btn-sm btn-text", aria: { label: "Edit environment #{env.qualified_name}" } %>
        <%= link_to "Edit connection", edit_connection_path(connection), class: "btn-sm btn-text", aria: { label: "Edit connection #{env.qualified_name}" } %>
        <%# Remove is the only destructive action on the row: it gets its own
            side of a hairline, so a slip aimed at Log in or Edit cannot land on it.
            It names the connection, since the environment stays behind. %>
        <div class="ml-auto sm:ml-3 sm:pl-3 sm:border-l sm:border-border">
          <%= button_to "Remove connection", connection_path(connection), method: :delete,
                form: { data: { turbo_confirm: t("hints.risks.remove_connection.confirm", env: env.qualified_name) } },
                class: "btn-sm btn-text-danger bg-transparent", aria: { label: "Remove connection #{env.qualified_name}" } %>
        </div>
      <% end %>
    <% elsif env.source == "local" %>
      <%= link_to "Connect", new_connection_path(project_env_id: env.id), class: "btn-sm btn-secondary", aria: { label: "Connect #{env.qualified_name} to its Kong node" } %>
      <%= link_to "Edit environment", edit_project_env_path(env), class: "btn-sm btn-text", aria: { label: "Edit environment #{env.qualified_name}" } %>
      <div class="ml-auto sm:ml-3 sm:pl-3 sm:border-l sm:border-border">
        <%= button_to "Remove environment", project_env_path(env), method: :delete,
              form: { data: { turbo_confirm: t("hints.risks.remove_environment.confirm", env: env.qualified_name) } },
              class: "btn-sm btn-text-danger bg-transparent", aria: { label: "Remove environment #{env.qualified_name}" } %>
      </div>
    <% end %>
  </div>

  <% if overview && connection %>
    <div class="env-row__counts">
      <% if synced %>
        <ul class="env-row__count-list" aria-label="In Kong, as this machine last synced it">
          <% ProjectOverview::COUNTED.each do |type| %>
            <li><span class="env-row__count"><%= overview.counts[type] %></span> <%= type.pluralize(overview.counts[type]) %></li>
          <% end %>
        </ul>
        <p class="env-row__sync">
          <% if synced < 1.day.ago %>
            <%= t("hints.pages.project_show.synced_stale_html", time: plan_timestamp(synced), age: time_ago_in_words(synced).delete_prefix("about ")) %>
          <% else %>
            <%= t("hints.pages.project_show.synced_html", time: plan_timestamp(synced)) %>
          <% end %>
        </p>
      <% else %>
        <p class="env-row__sync env-row__sync--never"><%= t("hints.pages.project_show.never_synced") %></p>
      <% end %>
    </div>
  <% end %>
</li>
