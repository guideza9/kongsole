<%# One project: its name, where it is edited, the repo it pushes to and the
    network that reaches it -- then its envs, in the project's own order. %>
<section class="project" aria-labelledby="project-<%= project.id %>">
  <header class="project__head">
    <div class="project__title-row">
      <h2 id="project-<%= project.id %>" class="project__name"><%= project.name %></h2>
      <span class="project__key font-mono"><%= project.key %></span>
      <%= source_badge(project.source) %>
      <% if project.source == "local" %>
        <span class="project__actions">
          <%= link_to "Add environment", new_project_env_path(project_id: project.id), class: "btn-sm btn-text" %>
          <%= link_to "Edit", edit_project_path(project), class: "btn-sm btn-text", aria: { label: "Edit project #{project.name}" } %>
        </span>
      <% end %>
    </div>
    <% if project.git_repo.present? || project.network_note.present? %>
      <dl class="project__meta">
        <% if project.git_repo.present? %>
          <div><dt>Config repo</dt><dd class="font-mono"><%= project.git_repo %><%= " @ #{project.git_branch}" if project.git_branch.present? %></dd></div>
        <% end %>
        <% if project.network_note.present? %>
          <div><dt>Network</dt><dd><%= project.network_note %></dd></div>
        <% end %>
      </dl>
    <% end %>
  </header>

  <% if project.project_envs.empty? %>
    <%= empty_state(:project_envs) do %>
      <% if project.source == "local" %>
        <%= link_to "Add environment", new_project_env_path(project_id: project.id), class: "btn-sm btn-secondary" %>
      <% end %>
    <% end %>
  <% else %>
    <ol class="env-list">
      <%= render partial: "connections/env_row", collection: project.project_envs, as: :env %>
    </ol>
  <% end %>
</section>
