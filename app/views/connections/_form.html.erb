<%= form_with model: connection, scope: :kong_connection,
      url: (connection.persisted? ? connection_path(connection) : connections_path),
      class: "max-w-xl" do |f| %>
  <% if connection.errors.any? %>
    <%= render layout: "shared/notice", locals: { tone: :danger, role: "alert", class: "mb-6 text-sm" } do %>
      <ul>
        <% connection.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <%# R1: the connection belongs to one env and takes its name, rank and
      apply mode from it. Only local envs with no connection yet are offered. %>
  <% env_choices = Project.where(source: "local").includes(project_envs: :kong_connection).order(:name).map do |project|
       envs = project.project_envs.select { |env| env.source == "local" && (env.kong_connection.nil? || env.kong_connection == connection) }
       [ project.name, envs.map { |env| [ env.qualified_name, env.id ] } ]
     end.reject { |_, envs| envs.empty? } %>
  <section class="panel p-4">
    <h2 class="section-label mb-3">Identity</h2>
    <div class="grid gap-4">
      <div>
        <%= f.label :project_env_id, "Environment", class: "block text-sm font-medium text-ink" %>
        <%= f.select :project_env_id, grouped_options_for_select(env_choices, connection.project_env_id || params[:project_env_id].to_i.nonzero?), { include_blank: true }, class: "field-input mt-1", aria: { describedby: hint_describedby(:connection, :project_env_id) } %>
        <%= field_hint(:connection, :project_env_id, quiet: true) %>
      </div>
    </div>
  </section>

  <section class="panel p-4 mt-4">
    <h2 class="section-label mb-3">Connectivity</h2>
    <div class="grid gap-4">
      <div>
        <%= f.label :admin_url, "Admin URL", class: "block text-sm font-medium text-ink" %>
        <%= f.text_field :admin_url, placeholder: hint_placeholder(:connection, :admin_url), class: "field-input mt-1 font-mono text-sm", aria: { describedby: hint_describedby(:connection, :admin_url) } %>
        <%= field_hint(:connection, :admin_url, quiet: true) %>
      </div>

      <div>
        <div class="flex items-center gap-2">
          <%= f.check_box :verify_ssl, class: "accent-accent", aria: { describedby: hint_describedby(:connection, :verify_ssl) } %>
          <%= f.label :verify_ssl, "Verify SSL", class: "text-sm text-ink" %>
        </div>
        <%= field_hint(:connection, :verify_ssl, quiet: true) %>
      </div>

      <div>
        <%= f.label :ca_bundle_path, "CA bundle path (optional)", class: "block text-sm font-medium text-ink" %>
        <%= f.text_field :ca_bundle_path, placeholder: hint_placeholder(:connection, :ca_bundle_path), class: "field-input mt-1", aria: { describedby: hint_describedby(:connection, :ca_bundle_path) } %>
        <%= field_hint(:connection, :ca_bundle_path, quiet: true) %>
      </div>
    </div>
  </section>

  <section class="panel p-4 mt-4">
    <h2 class="section-label mb-3">Access policy</h2>
    <div class="grid gap-4">
      <div>
        <%= f.label :credential_mode, class: "block text-sm font-medium text-ink" %>
        <%= f.select :credential_mode, KongConnection::CREDENTIAL_MODES, {}, class: "field-input mt-1", aria: { describedby: hint_describedby(:connection, :credential_mode) } %>
        <%= field_hint(:connection, :credential_mode, quiet: true) %>
      </div>
    </div>
  </section>

  <%= f.submit class: "btn btn-primary mt-6" %>
<% end %>
