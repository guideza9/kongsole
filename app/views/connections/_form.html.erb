<%= form_with model: connection, scope: :kong_connection,
      url: (connection.persisted? ? connection_path(connection) : connections_path),
      class: "max-w-xl" do |f| %>
  <% if connection.errors.any? %>
    <%= render layout: "shared/notice", locals: { tone: :danger, role: "alert", class: "mb-6 text-sm" } do %>
      <ul>
        <% connection.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <section class="panel p-4">
    <h2 class="section-label mb-3">Identity</h2>
    <div class="grid gap-4">
      <div>
        <%= f.label :name, class: "block text-sm font-medium text-ink" %>
        <%= f.text_field :name, class: "field-input mt-1" %>
      </div>

      <div>
        <%= f.label :env, class: "block text-sm font-medium text-ink" %>
        <%= f.select :env, KongConnection::ENVS, {}, class: "field-input mt-1", aria: { describedby: "env-hint" } %>
        <p id="env-hint" class="text-sm mt-1.5 text-ink-soft">
          The environment sets how careful the console is. uat and prod turn the chrome violet and ask for the connection name and your password before applying.
        </p>
      </div>
    </div>
  </section>

  <section class="panel p-4 mt-4">
    <h2 class="section-label mb-3">Connectivity</h2>
    <div class="grid gap-4">
      <div>
        <%= f.label :admin_url, "Admin URL", class: "block text-sm font-medium text-ink" %>
        <%= f.text_field :admin_url, placeholder: "https://kong-admin.internal", class: "field-input mt-1 font-mono text-sm" %>
        <p class="text-xs mt-1.5 text-ink-soft">https:// required unless it points at localhost — <code class="font-mono">insecure_http</code> in connections.yml is the only exception, never this form.</p>
      </div>

      <div class="flex items-center gap-2">
        <%= f.check_box :verify_ssl, class: "accent-accent" %>
        <%= f.label :verify_ssl, "Verify SSL", class: "text-sm text-ink" %>
      </div>

      <div>
        <%= f.label :ca_bundle_path, "CA bundle path (optional)", class: "block text-sm font-medium text-ink" %>
        <%= f.text_field :ca_bundle_path, class: "field-input mt-1" %>
      </div>
    </div>
  </section>

  <section class="panel p-4 mt-4">
    <h2 class="section-label mb-3">Access policy</h2>
    <div class="grid gap-4">
      <div>
        <%= f.label :apply_mode, class: "block text-sm font-medium text-ink" %>
        <%= f.select :apply_mode, KongConnection::APPLY_MODES, {}, class: "field-input mt-1" %>
      </div>

      <div>
        <%= f.label :credential_mode, class: "block text-sm font-medium text-ink" %>
        <%= f.select :credential_mode, KongConnection::CREDENTIAL_MODES, {}, class: "field-input mt-1" %>
        <p class="text-xs mt-1.5 text-ink-soft">
          <code class="font-mono">session</code>: credential lives only in the browser session, never touches the DB — no background sync, not usable from MCP.
          <code class="font-mono">stored</code>: encrypted in the DB — required for sync and MCP.
        </p>
      </div>
    </div>
  </section>

  <section class="panel p-4 mt-4">
    <h2 class="section-label mb-3">PR mode (uat/prod)</h2>
    <div>
      <%= f.label :select_tags_raw, "select_tags (comma separated)", class: "block text-sm font-medium text-ink" %>
      <%= f.text_field :select_tags_raw, class: "field-input mt-1 font-mono text-sm" %>
    </div>
  </section>

  <%= f.submit class: "btn btn-primary mt-6" %>
<% end %>
