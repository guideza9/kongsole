<% content_for :title, "Connections" %>

<div class="flex flex-wrap items-end justify-between gap-4 mb-8">
  <div>
    <h1 class="page-title">Connections</h1>
    <p class="text-sm mt-0.5 text-ink-soft"><%= t("hints.pages.connections.intro") %></p>
  </div>
  <div class="flex flex-wrap items-center gap-2 shrink-0">
    <%= link_to "Add connection", new_connection_path, class: "btn btn-secondary" %>
    <%= link_to "New project", new_project_path, class: "btn btn-primary" %>
  </div>
</div>

<% if @projects.empty? %>
  <%= empty_state(:connections) do %>
    <%= link_to "New project", new_project_path, class: "btn-sm btn-secondary" %>
  <% end %>
<% else %>
  <div class="project-list">
    <%= render partial: "connections/project", collection: @projects, as: :project %>
  </div>
<% end %>
