<% content_for :title, "Connections" %>

<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
  <div>
    <h1 class="page-title">Connections</h1>
    <p class="text-sm mt-0.5 text-ink-soft"><%= t("hints.pages.connections.intro") %></p>
  </div>
  <%= link_to "Add connection", new_connection_path, class: "btn btn-primary shrink-0" %>
</div>

<div class="grid gap-3">
  <% @connections.each do |connection| %>
    <div class="row-card p-4 flex flex-col sm:flex-row sm:items-center gap-4">
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <%= env_badge(connection, size: :lg) %>
          <%= status_badge(connection.last_status) %>
        </div>

        <div class="mt-2 text-sm font-mono truncate text-ink-soft"><%= connection.admin_url %></div>

        <div class="mt-2 flex flex-wrap gap-1.5">
          <% connection_policy_labels(connection).each do |label| %>
            <span class="tag"><%= label %></span>
          <% end %>
        </div>
      </div>

      <div class="flex items-center gap-2 text-sm w-full sm:w-auto shrink-0">
        <%= link_to "Log in", login_connection_path(connection), class: "btn-sm btn-secondary" %>
        <%= link_to "Edit", edit_connection_path(connection), class: "btn-sm btn-text" %>
        <%# Remove is the only destructive action on the row: it gets its own
            side of a hairline, so a slip aimed at Log in or Edit cannot land on it. %>
        <div class="ml-auto sm:ml-3 sm:pl-3 sm:border-l sm:border-border">
          <%= button_to "Remove", connection_path(connection), method: :delete,
                form: { data: { turbo_confirm: "Remove \"#{connection.name}\" from the registry? This does not touch anything in Kong itself." } },
                class: "btn-sm btn-text-danger bg-transparent" %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @connections.empty? %>
    <%= empty_state(:connections) %>
  <% end %>
</div>
