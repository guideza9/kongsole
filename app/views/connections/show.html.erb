<% content_for :title, @connection.name %>

<div class="flex items-center gap-3 mb-2">
  <h1 class="sr-only">Connection: <%= @connection.name %></h1>
  <%= env_badge(@connection, size: :lg) %>
  <%= status_badge(@connection.last_status) %>
</div>
<p class="text-sm mb-8 text-ink-soft"><%= t("hints.pages.connection_show.intro") %></p>

<% unless @connection.editable_in_ui? %>
  <div class="panel max-w-xl mb-6 p-4 text-sm">
    <p class="font-semibold text-ink">From config/connections.yml</p>
    <p class="mt-0.5 text-ink-soft">The team registry sets this connection and its environment. Edit it in <span class="font-mono">config/connections.yml</span> and run <span class="font-mono">bin/rails kong:load_connections</span>.</p>
  </div>
<% end %>

<div class="max-w-xl grid gap-4">
  <section class="panel p-4">
    <h2 class="section-label mb-3">Connectivity &amp; policy</h2>
    <dl class="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2 text-sm">
      <dt class="text-ink-soft">Project</dt><dd><%= @connection.project&.name %></dd>
      <dt class="text-ink-soft">Environment</dt><dd class="font-mono"><%= @connection.name %></dd>
      <% if @connection.project_env %>
        <dt class="text-ink-soft">Rank</dt><dd><%= rank_label(@connection.project_env) %></dd>
      <% end %>
      <dt class="text-ink-soft">Admin URL</dt><dd class="font-mono"><%= @connection.admin_url %></dd>
      <dt class="text-ink-soft">Apply mode</dt><dd><%= @connection.project_env ? write_policy_label(@connection.project_env.write_policy) : apply_mode_label(@connection.apply_mode) %></dd>
      <dt class="text-ink-soft">Credential mode</dt><dd><%= @connection.credential_mode %></dd>
    </dl>
  </section>

  <section class="panel p-4">
    <h2 class="section-label mb-3">Discovered from Kong</h2>
    <dl class="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2 text-sm">
      <dt class="text-ink-soft">Access level</dt><dd><%= @connection.access_level || "unknown — log in to probe" %></dd>
      <dt class="text-ink-soft">Credential kind</dt><dd><%= @connection.credential_kind || "unknown — log in to classify" %></dd>
      <dt class="text-ink-soft">Kong version</dt><dd><%= @connection.kong_version || "—" %></dd>
      <dt class="text-ink-soft">Last connected</dt><dd><%= plan_timestamp(@connection.last_connected_at) || "never" %></dd>
      <dt class="text-ink-soft">Admin path fingerprint</dt>
      <dd>
        <% if @connection.admin_path_fingerprint.present? && @connection.admin_path_fingerprint["service_id"] %>
          <%= status_badge("guarded") %>
          <span class="text-ink-soft">service <%= @connection.admin_path_fingerprint["service_id"] %>, <%= Array(@connection.admin_path_fingerprint["route_ids"]).size %> route(s), <%= Array(@connection.admin_path_fingerprint["consumer_ids"]).size %> consumer(s)</span>
        <% else %>
          <%= status_badge("unknown") %>
          <span class="text-ink-soft">not found yet — log in to run the admin path guard</span>
        <% end %>
      </dd>
    </dl>
  </section>
</div>

<div class="mt-6 flex gap-2">
  <%= link_to "Log in", login_connection_path(@connection), class: "btn btn-primary" %>
  <% if @connection.editable_in_ui? %>
    <%= link_to "Edit", edit_connection_path(@connection), class: "btn btn-secondary" %>
  <% end %>
  <%= link_to "Back", connections_path, class: "btn btn-text" %>
</div>
