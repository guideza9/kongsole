<%# R1.19: a project's other actions, out of the way of the envs. A native
    disclosure like the header's env switcher: keyboard and screen readers get
    it for free, and it opens without JS. Only a local project is edited here;
    one from config/connections.yml is only opened. %>
<details class="project-menu">
  <summary class="project-menu__summary" aria-label="Actions for <%= project.name %>" title="Actions for <%= project.name %>">
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path d="M2.5 4h11M2.5 8h11M2.5 12h11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  </summary>
  <ul class="project-menu__panel">
    <li><%= link_to "Open project", project_path(project), class: "project-menu__item" %></li>
    <% if project.source == "local" %>
      <li><%= link_to "Add environment", new_project_env_path(project_id: project.id), class: "project-menu__item" %></li>
      <li><%= link_to "Edit project details", edit_project_path(project), class: "project-menu__item" %></li>
    <% end %>
  </ul>
</details>
