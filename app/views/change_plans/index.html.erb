<% content_for :title, "Pending PRs" %>

<h1 class="page-title mb-1">Pending PRs</h1>
<p class="text-sm mb-6 text-ink-soft">Every PR-mode change plan on <%= current_connection.name %>, newest first.</p>

<% if @change_plans.empty? %>
  <div class="panel p-6 text-sm text-center text-ink-soft">No PR-mode changes have been proposed on this connection yet.</div>
<% else %>
  <div class="overflow-x-auto panel">
    <table class="w-full text-sm min-w-[720px]">
      <thead>
        <tr class="text-left border-b border-border bg-surface-subtle">
          <th scope="col" class="px-3 py-2 section-label">Proposed</th>
          <th scope="col" class="px-3 py-2 section-label">Actor</th>
          <th scope="col" class="px-3 py-2 section-label">Operation</th>
          <th scope="col" class="px-3 py-2 section-label">Entity</th>
          <th scope="col" class="px-3 py-2 section-label">Status</th>
          <th scope="col" class="px-3 py-2 section-label">PR state</th>
          <th scope="col" class="px-3 py-2 section-label">Branch</th>
        </tr>
      </thead>
      <tbody>
        <% @change_plans.each do |plan| %>
          <tr class="border-b border-border">
            <td class="px-3 py-2.5 font-mono whitespace-nowrap text-ink-soft"><%= plan_timestamp(plan.created_at) %></td>
            <td class="px-3 py-2.5"><%= actor_summary(plan) %></td>
            <td class="px-3 py-2.5"><span class="tag"><%= plan.operation %></span></td>
            <td class="px-3 py-2.5"><%= link_to plan.entity_label, change_plan_path(plan) %></td>
            <td class="px-3 py-2.5"><%= status_badge(plan.status) %></td>
            <td class="px-3 py-2.5"><%= pr_state_label(plan.pr_state) %></td>
            <td class="px-3 py-2.5 font-mono text-xs"><%= plan_branch_cell(plan, current_connection) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
