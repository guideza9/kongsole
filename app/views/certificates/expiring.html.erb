<% content_for :title, "Expiring certificates" %>

<div class="flex flex-wrap items-center justify-between gap-4 mb-4">
  <div>
    <h1 class="page-title">Expiring certificates</h1>
    <p class="text-sm mt-0.5 text-ink-soft">
      <%= t("hints.pages.certificates_expiring.intro") %> Within <%= @days %> days on <%= current_connection.name %>, expired ones included.
      <% if @last_synced_at %>Last synced <%= time_ago_in_words(@last_synced_at) %> ago.<% else %>This connection has never synced.<% end %>
    </p>
  </div>
  <nav class="tab-nav" aria-label="Window">
    <% CertificatesController::WINDOWS.each do |window| %>
      <%= link_to "#{window} days", expiring_certificates_path(days: window),
            class: "tab",
            aria: { current: (@days == window ? "page" : nil) } %>
    <% end %>
  </nav>
</div>

<% if @entities.empty? %>
  <%# Never synced is "unknown", not "safe": it must not read as nothing expiring. %>
  <% if @last_synced_at %>
    <%= empty_state(:certificates_expiring, days: @days) %>
  <% else %>
    <%= empty_state(:"certificates_expiring.never_synced") do %>
      <%= link_to "Go to Entities", entities_path(type: "certificate"), class: "btn-sm btn-secondary" %>
    <% end %>
  <% end %>
<% else %>
  <div class="overflow-x-auto panel">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left"><th scope="col" class="section-label px-3 py-2">Name</th><th scope="col" class="section-label px-3 py-2">Kind</th><th scope="col" class="section-label px-3 py-2">Expires</th><th scope="col" class="section-label px-3 py-2">On</th></tr>
      </thead>
      <tbody>
        <% @entities.each do |entity| %>
          <tr class="border-t border-border">
            <td class="px-3 py-2.5 font-semibold"><%= link_to entity.name.presence || entity.kong_id, entity_path(entity) %></td>
            <td class="px-3 py-2.5 text-ink-soft"><%= entity_type_label(entity.entity_type, count: 1) %></td>
            <td class="px-3 py-2.5"><span class="inline-flex flex-wrap items-center gap-1.5"><%= expiry_badge(entity) %> <span class="text-xs text-ink-soft"><%= expiry_when(entity) %></span></span></td>
            <td class="px-3 py-2.5 font-mono text-xs whitespace-nowrap"><%= plan_timestamp(entity.not_after) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
