<%= form_with model: project_env, scope: :project_env,
      url: (project_env.persisted? ? project_env_path(project_env) : project_envs_path), class: "max-w-xl" do |f| %>
  <% if project_env.errors.any? %>
    <%= render layout: "shared/notice", locals: { tone: :danger, role: "alert", class: "mb-6 text-sm" } do %>
      <ul><% project_env.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    <% end %>
  <% end %>

  <%= f.hidden_field :project_id unless project_env.persisted? %>
  <div class="grid gap-4">
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-ink" %>
      <%= f.text_field :name, class: "field-input mt-1 font-mono" %>
    </div>
    <div>
      <%= f.label :position, class: "block text-sm font-medium text-ink" %>
      <%= f.number_field :position, class: "field-input mt-1" %>
    </div>
    <div>
      <%= f.label :rank, class: "block text-sm font-medium text-ink" %>
      <%= f.select :rank, (0..3).to_a, { include_blank: true }, class: "field-input mt-1" %>
    </div>
    <div>
      <%= f.label :apply_mode, class: "block text-sm font-medium text-ink" %>
      <%= f.select :apply_mode, [ [ "Not set (read only)", "" ], [ "Direct apply", "direct" ] ], {}, class: "field-input mt-1" %>
    </div>
    <div>
      <%= f.label :color_tag, class: "block text-sm font-medium text-ink" %>
      <%= f.text_field :color_tag, class: "field-input mt-1" %>
    </div>
  </div>

  <%= f.submit class: "btn btn-primary mt-6" %>
<% end %>
