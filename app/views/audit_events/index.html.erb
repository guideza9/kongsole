<% content_for :title, "Audit log" %>

<% lede = page_lede("hints.pages.audit_events.intro") %>
<h1 class="page-title <%= lede ? "mb-1" : "mb-6" %>">Audit log</h1>
<% if lede %><p class="text-sm mb-6 text-ink-soft"><%= lede %></p><% end %>

<% if @audit_events.empty? %>
  <%= empty_state(:audit_events) %>
<% else %>
  <div class="overflow-x-auto panel">
    <table class="w-full text-sm min-w-[720px]">
      <thead>
        <tr class="text-left border-b border-border bg-surface-subtle">
          <th scope="col" class="px-3 py-2 section-label">When</th>
          <th scope="col" class="px-3 py-2 section-label">Actor</th>
          <th scope="col" class="px-3 py-2 section-label">Operation</th>
          <th scope="col" class="px-3 py-2 section-label">Entity</th>
        </tr>
      </thead>
      <tbody>
        <% @audit_events.each do |event| %>
          <tr class="border-b border-border" id="audit-event-<%= event.id %>">
            <td class="px-3 py-2.5 font-mono whitespace-nowrap text-ink-soft"><%= plan_timestamp(event.created_at) %></td>
            <td class="px-3 py-2.5"><%= actor_summary(event) %></td>
            <td class="px-3 py-2.5"><span class="tag"><%= event.operation %></span></td>
            <td class="px-3 py-2.5">
              <%# The plan behind the event holds the diff. Older events, and any
                  recorded without a plan, have nothing to open. %>
              <% name = event.entity_name.presence || event.entity_type.humanize %>
              <% if event.change_plan_id %>
                <%= link_to change_plan_path(event.change_plan_id) do %><%= name %><span class="sr-only"> — open this change and its diff</span><% end %>
              <% else %>
                <%= name %>
              <% end %>
              <span class="text-ink-faint">(<%= event.entity_type %>)</span>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
