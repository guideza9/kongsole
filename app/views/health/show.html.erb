<% content_for :title, "Health" %>

<h1 class="page-title mb-1">Connection health</h1>
<p class="text-sm mb-6 text-ink-soft"><%= t("hints.pages.health.intro") %> Log in again to recheck.</p>

<div class="overflow-x-auto panel">
  <table class="w-full text-sm min-w-[720px]">
    <thead>
      <tr class="text-left border-b border-border bg-surface-subtle">
        <th scope="col" class="px-2.5 py-2 section-label">Connection</th>
        <th scope="col" class="px-2.5 py-2 section-label">Last known status</th>
        <th scope="col" class="px-2.5 py-2 section-label">Access</th>
        <th scope="col" class="px-2.5 py-2 section-label">Credential</th>
        <th scope="col" class="px-2.5 py-2 section-label">Admin path</th>
        <th scope="col" class="px-2.5 py-2 section-label">Last connected</th>
        <th scope="col" class="px-2.5 py-2"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% @connections.each do |connection| %>
        <tr class="border-b border-border">
          <td class="px-2.5 py-2.5">
            <%= env_badge(connection) %>
          </td>
          <td class="px-2.5 py-2.5"><%= status_badge(connection.last_status) %></td>
          <td class="px-2.5 py-2.5 whitespace-nowrap"><%= access_level_label(connection.access_level) || "—" %></td>
          <%# The column is already headed Credential: the kind alone is enough. %>
          <td class="px-2.5 py-2.5 whitespace-nowrap"><%= connection.credential_kind&.humanize || "—" %></td>
          <td class="px-2.5 py-2.5">
            <%= status_badge(connection.admin_path_fingerprint.present? && connection.admin_path_fingerprint["service_id"] ? "guarded" : "unknown") %>
          </td>
          <td class="px-2.5 py-2.5 font-mono whitespace-nowrap text-ink-soft"><%= plan_timestamp(connection.last_connected_at) || "never" %></td>
          <td class="px-2.5 py-2.5">
            <%# The same two actions the connection card offers, minus Remove: a
                health page is for acting on what it shows, not for deleting. %>
            <div class="flex items-center justify-end gap-2 whitespace-nowrap">
              <%= link_to "Log in", login_connection_path(connection), class: "btn-sm btn-secondary" %>
              <%= link_to "Details", connection_path(connection), class: "btn-sm btn-text" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
