<%# One row of the entity table (see entities/index: role="table"). The row is a
    real row and each column a cell; the name is the one link, stretched over the
    whole row by CSS so the entire row is still the click target. %>
<div class="entity-row<%= " entity-row--admin" if entity.is_admin_path? %>" role="row">
  <% if type.in?(%w[certificate ca_certificate]) %>
    <% hostnames = certificate_hostnames(entity) %>
    <span role="cell" class="entity-cell" title="<%= entity.name %>">
      <%= link_to entity.name, entity_path(entity), class: "entity-link block font-semibold text-sm text-ink truncate" %>
      <% if hostnames[:shown].any? %>
        <span class="block font-mono text-xs truncate text-ink-soft"><%= hostnames[:shown].join(", ") %><%= " +#{hostnames[:more]}" if hostnames[:more].positive? %></span>
      <% end %>
    </span>
  <% else %>
    <span role="cell" class="entity-cell" title="<%= entity.name %>"><%= link_to entity.name, entity_path(entity), class: "entity-link font-semibold text-sm text-ink" %></span>
  <% end %>

  <% if type == "route" %>
    <span role="cell" class="entity-cell"><%= render "entities/route_match", match: route_match(entity) %></span>
  <% end %>

  <% if type == "plugin" %>
    <span role="cell" class="entity-cell"><%= render "entities/scope", scope: plugin_scope(entity) %></span>
  <% end %>

  <% if type == "upstream" %>
    <span role="cell" class="entity-cell font-mono text-xs text-ink-soft"><%= entity.data["algorithm"] || "—" %></span>
  <% end %>

  <% if type == "target" %>
    <span role="cell" class="entity-cell font-mono text-xs tabular-nums text-ink-soft"><%= entity.data["weight"] || "—" %></span>
  <% end %>

  <% if type == "certificate" %>
    <span role="cell" class="entity-cell font-mono text-xs tabular-nums text-ink-soft"><%= Array(entity.data["snis"]).size %></span>
  <% end %>

  <% if type.in?(%w[certificate ca_certificate]) %>
    <div role="cell" class="entity-cell flex flex-wrap items-center gap-1.5">
      <%= expiry_badge(entity) %>
      <% if entity.not_after %>
        <span class="text-xs text-ink-soft"><%= expiry_when(entity) %></span>
      <% end %>
    </div>
  <% end %>

  <div role="cell" class="entity-cell flex items-center gap-1.5">
    <% visible_tags(entity).each do |tag| %>
      <span class="tag"><%= tag %></span>
    <% end %>
    <% if hidden_tag_count(entity).positive? %>
      <span class="text-xs shrink-0 text-ink-faint">+<%= hidden_tag_count(entity) %></span>
    <% end %>
  </div>

  <%# Kong's Route/Consumer/credential schemas have no `enabled` field at
      all -- confirmed live (PATCHing a route with `enabled` present is a
      400 "unknown field") -- so their Status can only ever be "protected"
      or nothing. service and plugin are the two types that genuinely have
      the field. %>
  <% has_enabled_field = type.in?(%w[service plugin]) %>
  <div role="cell" class="entity-cell flex items-center gap-1.5">
    <% if entity.is_admin_path? %>
      <%= render "shared/admin_path_chip" %>
    <% end %>
    <% if has_enabled_field && !entity.enabled %>
      <span class="tag shrink-0">disabled</span>
    <% end %>
    <% unless entity.is_admin_path? || (has_enabled_field && !entity.enabled) %>
      <span class="text-ink-faint">—</span>
    <% end %>
  </div>

  <span role="cell" class="entity-cell font-mono text-xs tabular-nums text-ink-faint">
    <%= plan_timestamp(entity.kong_updated_at) || "—" %>
  </span>
</div>
