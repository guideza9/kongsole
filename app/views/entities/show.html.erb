<% content_for :title, @entity.name %>

<div class="flex flex-wrap items-center gap-2 mb-1">
  <h1 class="page-title"><%= @entity.name %></h1>
  <% if @entity.is_admin_path? %>
    <%= render "shared/admin_path_chip" %>
  <% end %>
</div>
<p class="text-sm mb-6 text-ink-soft"><%= entity_type_label(@entity.entity_type, count: 1).downcase %> · <%= current_connection.name %></p>

<div class="max-w-2xl grid gap-4">
  <% if write_block_reason %>
    <%= render "shared/write_blocked" %>
  <% end %>

  <%# The one entity Kongsole cannot afford to lose says so before anything
      else on the page, and says what that means for delete and for decK. %>
  <% if @entity.is_admin_path? %>
    <%= render layout: "shared/notice", locals: { tone: :warning, role: "status", class: "admin-path-notice" } do %>
      <p class="admin-path-notice__title"><%= render "shared/lock_icon" %> This is Kongsole's own way into Kong.</p>
      <% if @entity.entity_type == "plugin" %>
        <p class="text-sm font-normal mt-1">It guards the admin route, so it is read-only here: it can't be edited or deleted, by a person or an agent.</p>
      <% else %>
        <p class="text-sm font-normal mt-1">Deleting it would lock the team out of the Admin API. An agent can never delete it; deleting it here needs its name typed; and it is left out of every decK YAML file.</p>
      <% end %>
    <% end %>
  <% end %>

  <% if @entity.entity_type == "route" %>
    <%= render "entities/route_panel", entity: @entity %>
  <% elsif @entity.entity_type == "plugin" %>
    <%= render "entities/plugin_panel", entity: @entity %>
  <% end %>

  <section class="panel p-4">
    <h2 class="section-label mb-3">Overview</h2>
    <dl class="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2 text-sm">
      <dt class="text-ink-soft">Kong ID</dt><dd class="font-mono"><%= @entity.kong_id %></dd>
      <dt class="text-ink-soft">Logical key</dt><dd><%= @entity.logical_key %></dd>
      <% if @entity.entity_type.in?(%w[service plugin]) %>
        <dt class="text-ink-soft">Enabled</dt><dd><%= @entity.enabled ? "yes" : "no" %></dd>
      <% end %>
      <dt class="text-ink-soft">Tags</dt>
      <dd>
        <% if @entity.tags.any? %>
          <div class="flex flex-wrap gap-1.5">
            <% @entity.tags.each do |tag| %><span class="tag"><%= tag %></span><% end %>
          </div>
        <% else %>—<% end %>
      </dd>
      <dt class="text-ink-soft">Created in Kong</dt><dd><%= plan_timestamp(@entity.kong_created_at) || "—" %></dd>
      <dt class="text-ink-soft">Updated in Kong</dt><dd><%= plan_timestamp(@entity.kong_updated_at) || "—" %></dd>
      <dt class="text-ink-soft">Last synced</dt><dd><%= plan_timestamp(@entity.synced_at) || "—" %></dd>
    </dl>
  </section>

  <% if @entity.entity_type.in?(%w[certificate ca_certificate]) %>
    <%= render "certificate_details" %>
  <% end %>

  <section class="panel p-4">
    <h2 class="section-label mb-3">Raw JSON <span class="font-normal normal-case tracking-normal text-ink-faint">(redacted at sync time)</span></h2>
    <pre class="json-viewer text-xs font-mono overflow-x-auto p-3 rounded bg-surface-subtle border border-border"><%= highlight_json(@entity.data) %></pre>
  </section>

  <% @child_groups.each do |label, children| %>
    <section class="panel p-4">
      <div class="flex items-center justify-between mb-3">
        <h2 class="section-label">
          <%= label %>
        </h2>
        <% if write_block_reason %>
          <%# R1.14: no Add where nothing can be written. %>
        <% elsif label == "Plugins" %>
          <%= link_to "Add plugin", new_plugin_path(scope_type: @entity.entity_type, scope_kong_id: @entity.kong_id), class: "btn-text px-2 py-1 text-xs" %>
        <% elsif label == "Targets" %>
          <%= link_to "Add target", new_entity_path(type: "target", parent_kong_id: @entity.kong_id), class: "btn-text px-2 py-1 text-xs" %>
        <% elsif label == "SNIs" %>
          <%= link_to "Add SNI", new_entity_path(type: "sni", parent_kong_id: @entity.kong_id), class: "btn-text px-2 py-1 text-xs" %>
        <% end %>
      </div>
      <% if children.empty? %>
        <%= empty_state(:"entity_children.#{label.downcase}") %>
      <% else %>
        <div class="grid gap-px bg-border">
          <%= render partial: "entity", collection: children %>
        </div>
      <% end %>
    </section>
  <% end %>
</div>

<div class="mt-6 flex gap-2">
  <% if @entity.entity_type == "plugin" && @entity.is_admin_path? %>
    <p class="text-sm text-ink-soft">
      Read-only — this plugin fronts the connection's own admin path and can't be edited or deleted here.
    </p>
  <% elsif !write_block_reason %>
    <%= link_to "Edit", edit_entity_path(@entity), class: "btn-sm btn-secondary" %>
    <%= button_to "Delete", entity_path(@entity), method: :delete, class: "btn-sm btn-text-danger bg-transparent" %>
  <% end %>
  <%= link_to "Back to #{entity_type_label(@entity.entity_type).downcase}", entities_path(type: @entity.entity_type), class: "btn-sm btn-text" %>
</div>
