<% content_for :title, "Edit #{@entity.name}" %>

<h1 class="page-title mb-1">Edit <%= @entity.name %></h1>
<p class="text-sm mb-6 text-ink-soft"><%= t("hints.pages.entities_edit.intro") %></p>

<div class="max-w-2xl grid gap-4">
  <%= form_with url: entity_path(@entity), method: :patch, class: "grid gap-4" do %>
    <section class="panel p-4">
      <h2 class="section-label mb-3">Fields</h2>
      <div class="grid gap-4">
        <div>
          <label for="entity-tags" class="block text-sm font-medium mb-1 text-ink">Tags <span class="font-normal text-ink-soft">(comma separated)</span></label>
          <input type="text" id="entity-tags" name="tags" value="<%= @entity.tags.join(', ') %>" class="field-input font-mono text-sm" aria-describedby="<%= hint_describedby(:entity_edit, :tags) %>" />
          <%= field_hint(:entity_edit, :tags) %>
        </div>
        <% if @entity.entity_type == "service" %>
          <div>
            <div class="flex items-center gap-2">
              <input type="hidden" name="enabled" value="0" />
              <input class="accent-accent" type="checkbox" id="enabled" name="enabled" value="1" <%= "checked" if @entity.enabled %> aria-describedby="<%= hint_describedby(:entity_edit, :enabled) %>" />
              <label for="enabled" class="text-sm text-ink">Enabled</label>
            </div>
            <%= field_hint(:entity_edit, :enabled) %>
          </div>
        <% end %>
      </div>
      <div class="flex gap-2 mt-4">
        <button type="submit" class="btn-primary btn">Review change</button>
        <%= link_to "Cancel", entity_path(@entity), class: "btn-sm btn-text" %>
      </div>
    </section>
  <% end %>

  <%= form_with url: entity_path(@entity), method: :patch, data: { controller: "json-editor" } do %>
    <section class="panel p-4">
      <h2 id="json-editor-heading" class="section-label mb-3">Full JSON</h2>
      <p id="json-editor-help" class="text-xs mb-3 text-ink-soft">
        Every field on this <%= @entity.entity_type.humanize.downcase %>, straight from Kong.
        Removing a key leaves that field <em>unchanged</em> — set it to <code class="font-mono">null</code> to clear it.
        <% if @entity.entity_type == "certificate" %>
          The private key is a <em>reference</em> (<code class="font-mono">{vault://env/…}</code>); a key itself can't be entered here.
        <% elsif Kong::Redactor::SENSITIVE_FIELDS_BY_ENTITY.key?(@entity.entity_type) %>
          Secrets show as <code class="font-mono"><%= Kong::Redactor::MARK %></code> and can't be set here.
        <% end %>
      </p>

      <% if @payload_stale %>
        <%= render layout: "shared/notice", locals: { tone: :warning, role: "status", tag: :p, class: "mb-3 text-xs" } do %>
          Kong is unreachable, so this is the copy from the last sync — it may be out of date.
        <% end %>
      <% end %>

      <% if @payload_error.present? %>
        <%= render layout: "shared/notice", locals: { tone: :danger, role: "alert", tag: :p, class: "mb-3 text-xs" } do %>
          <%= @payload_error %>
        <% end %>
        <% if @payload_withheld %>
          <p class="text-xs mb-3 text-ink-soft">
            Your text wasn't kept because it may contain key material, so the editor shows the current document again.
          </p>
        <% end %>
      <% end %>

      <div class="json-editor" data-json-editor-target="wrapper">
        <pre class="json-editor__highlight json-viewer" aria-hidden="true" data-json-editor-target="highlight"></pre>
        <textarea name="payload_json" rows="18" spellcheck="false" autocomplete="off"
                  aria-labelledby="json-editor-heading" aria-describedby="json-editor-help"
                  class="json-editor__textarea"
                  data-json-editor-target="input"
                  data-action="input->json-editor#validate scroll->json-editor#syncScroll"><%= @payload_json %></textarea>
      </div>

      <p role="status" class="text-xs mt-2 font-mono text-ink-faint" data-json-editor-target="status"></p>

      <div class="flex gap-2 mt-4">
        <button type="submit" class="btn-primary btn" data-json-editor-target="submit">Review change</button>
        <button type="button" class="btn-sm btn-secondary" data-action="json-editor#format">Format</button>
        <%= link_to "Cancel", entity_path(@entity), class: "btn-sm btn-text" %>
      </div>
    </section>
  <% end %>

  <%= render "field_guide", entity_type: @entity.entity_type, schema_fields: @schema_fields %>
</div>
