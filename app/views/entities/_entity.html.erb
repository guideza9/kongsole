<%= link_to entity_path(entity), class: "entity-row-compact#{" entity-row--admin" if entity.is_admin_path?}" do %>
  <span class="font-semibold text-sm shrink-0 truncate max-w-[45%] text-ink"><%= entity.name %></span>
  <% if entity.is_admin_path? %>
    <%= render "shared/admin_path_chip" %>
  <% end %>
  <%# Only an explicit `false` from Kong means disabled. The read-model stores
      NULL for a type with no `enabled` field at all (route, credential,
      target), which must not read as "disabled". %>
  <% if entity.enabled == false %>
    <span class="tag shrink-0">disabled</span>
  <% end %>
  <div class="flex flex-wrap gap-1.5 flex-1 min-w-0">
    <% entity.tags.each do |tag| %>
      <span class="tag"><%= tag %></span>
    <% end %>
  </div>
  <span class="text-xs shrink-0 text-ink-faint">
    <%= plan_timestamp(entity.kong_updated_at) || "—" %>
  </span>
<% end %>
