<% content_for :title, "New #{creatable_type_name(@creatable_type)}" %>

<% lede = page_lede("hints.pages.entities_new.intro") %>
<h1 class="page-title <%= lede || @parent ? "mb-1" : "mb-6" %>">New <%= creatable_type_name(@creatable_type) %></h1>
<% if lede || @parent %>
  <p class="text-sm mb-6 text-ink-soft">
    <% if @parent %><span class="font-mono"><%= @parent.entity_type %>: <%= @parent.name %></span><% end %>
    <% if @parent && lede %> · <% end %><%= lede %>
  </p>
<% end %>

<div class="max-w-2xl grid gap-4">
  <%# Presets seed the editor server-side (a plain GET), same idea as the
      plugin catalog step -- no client script needed to switch starting point. %>
  <% if @creatable_type == "upstream" %>
    <nav class="tab-nav flex-wrap items-center" aria-label="Start from">
      <span class="section-label">Start from</span>
      <% Kong::UpstreamPresets.choices.each do |key, label| %>
        <% active = params[:preset].to_s == key.to_s %>
        <%= link_to label, new_entity_path(type: "upstream", preset: key),
              class: "tab",
              aria: { current: (active ? "true" : nil) } %>
      <% end %>
    </nav>
  <% end %>

  <% if @creatable_type == "certificate" %>
    <section class="panel p-4 text-sm text-ink-soft">
      <h2 class="section-label mb-2">Private key</h2>
      <p>
        A private key can't be pasted here. Set it as an environment variable on every Kong node, then reference it:
        <code class="font-mono">{vault://env/cert-payments-key}</code> makes Kong read
        <code class="font-mono">CERT_PAYMENTS_KEY</code>.
        <% if current_connection.apply_mode == "pr" %>
          In PR mode you can also use <code class="font-mono">${{ env "DECK_CERT_PAYMENTS_KEY" }}</code>, filled in by CI.
        <% end %>
      </p>
      <p class="mt-2">
        Kong doesn't check that the variable exists — if it is missing, TLS for this certificate's hostnames fails.
        You'll be asked to confirm it is set before this is applied.
      </p>
    </section>
  <% end %>

  <%= form_with url: entities_path, method: :post, data: { controller: "json-editor" } do %>
    <input type="hidden" name="type" value="<%= @creatable_type %>" />
    <% if @parent %>
      <input type="hidden" name="parent_kong_id" value="<%= @parent.kong_id %>" />
    <% end %>

    <section class="panel p-4">
      <h2 id="json-editor-heading" class="section-label mb-3"><%= creatable_type_name(@creatable_type).sub(/\A./, &:upcase) %> document</h2>
      <p id="json-editor-help" class="text-xs mb-3 text-ink-soft">
        Kong checks this against its own schema when you press Review, and reports any field it rejects.
      </p>

      <% if @payload_error.present? %>
        <%= render layout: "shared/notice", locals: { tone: :danger, role: "alert", tag: :p, class: "mb-3 text-xs" } do %>
          <%= @payload_error %>
        <% end %>
        <% if flash.now[:error_explanation].present? %>
          <%= render layout: "shared/notice", locals: { tone: :danger, class: "mb-3 text-xs" } do %>
            <%= render "shared/error_explanation", explanation: flash.now[:error_explanation] %>
          <% end %>
        <% end %>
        <% if @payload_withheld %>
          <p class="text-xs mb-3 text-ink-soft">
            Your text wasn't kept because it may contain key material, so the editor is back at its starting document.
          </p>
        <% end %>
      <% end %>

      <div class="json-editor" data-json-editor-target="wrapper">
        <pre class="json-editor__highlight json-viewer" aria-hidden="true" data-json-editor-target="highlight"></pre>
        <textarea name="payload_json" rows="18" spellcheck="false" autocomplete="off"
                  aria-labelledby="json-editor-heading" aria-describedby="json-editor-help"
                  class="json-editor__textarea"
                  data-json-editor-target="input"
                  data-action="input->json-editor#validate scroll->json-editor#syncScroll"><%= @payload_json %></textarea>
      </div>

      <p role="status" class="text-xs mt-2 font-mono text-ink-faint" data-json-editor-target="status"></p>

      <div class="flex gap-2 mt-4">
        <button type="submit" class="btn-primary btn" data-json-editor-target="submit">Review change</button>
        <button type="button" class="btn-sm btn-secondary" data-action="json-editor#format">Format</button>
        <%= link_to "Cancel", (@parent ? entity_path(@parent) : entities_path(type: @creatable_type)), class: "btn-sm btn-text" %>
      </div>
    </section>
  <% end %>

  <%= render "field_guide", entity_type: @creatable_type, schema_fields: @schema_fields %>
</div>
