<% content_for :title, entity_type_label(@type) %>

<%
  certificate_type = %w[certificate ca_certificate].include?(@type)
  # CA certificates are a sibling of certificates, not a destination of their
  # own: one tab, and the other kind is a link in the header.
  active_tab = certificate_type ? "certificate" : @type
  extra_filters = [ @filters[:tags].present?, @filters[:sort].present? && @filters[:sort] != "-updated_at" ].count(true)
  filtered = @filters[:q].present? || extra_filters.positive?
%>

<div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-3 mb-4">
  <div>
    <h1 class="page-title"><%= entity_type_label(@type) %></h1>
    <%# Sync is upkeep, not the page's job: a quiet action beside the sentence
        that says how fresh the data is, so the header keeps one filled button. %>
    <div class="text-sm mt-0.5 flex flex-wrap items-center gap-x-1.5 text-ink-soft">
      <%= sync_freshness(@synced_at, current_connection.name) %>
      <%= button_to "Sync now", sync_entities_path(type: @type), method: :post,
            form: { class: "inline" }, class: "underline underline-offset-2 bg-transparent border-0 p-0 text-accent" %>
    </div>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <% if certificate_type %>
      <%= link_to "Expiring soon", expiring_certificates_path, class: "btn-sm btn-text" %>
      <%= link_to(@type == "certificate" ? "CA certificates" : "Certificates", entities_path(type: @type == "certificate" ? "ca_certificate" : "certificate"), class: "btn-sm btn-text") %>
    <% end %>
    <% if !can_propose_writes? %>
      <%# R1.14 / R2.7: nothing to offer -- the notice below says why. %>
    <% elsif @type == "service" %>
      <%= link_to "New service", new_service_path, class: "btn-primary btn" %>
    <% elsif @type == "plugin" %>
      <%= link_to "New global plugin", new_plugin_path, class: "btn-primary btn" %>
    <% elsif @type == "upstream" %>
      <%= link_to "New upstream", new_entity_path(type: "upstream"), class: "btn-primary btn" %>
    <% elsif certificate_type %>
      <%= link_to(@type == "certificate" ? "New certificate" : "New CA certificate", new_entity_path(type: @type), class: "btn-primary btn") %>
    <% end %>
  </div>
</div>

<% if write_block_reason %>
  <%= render "shared/write_blocked", class: "mb-4" %>
<% end %>

<nav aria-label="Entity types" class="tab-nav tab-nav--rule mb-6">
  <% %w[service route consumer plugin upstream certificate].each do |type| %>
    <%= link_to entity_type_label(type), entities_path(type: type),
          class: "tab",
          aria: { current: (active_tab == type ? "page" : nil) } %>
  <% end %>
</nav>

<%# One field and one button in view; tags and sort are a disclosure that opens
    itself when either is in use, so an active filter is never hidden. %>
<%= form_with url: entities_path, method: :get, class: "panel p-3 mb-5 grid gap-3" do %>
  <input type="hidden" name="type" value="<%= @type %>" />
  <div class="flex flex-wrap items-end gap-3">
    <div class="flex-1 min-w-[180px]">
      <label for="entities-q" class="block text-sm font-medium mb-1 text-ink">Search</label>
      <input type="text" id="entities-q" name="q" value="<%= @filters[:q] %>" placeholder="name contains…" class="field-input" aria-describedby="<%= hint_describedby(:entity_filter, :q) %>" />
      <%= field_hint(:entity_filter, :q, quiet: true) %>
    </div>
    <button type="submit" class="btn-secondary btn">Filter</button>
    <% if filtered %>
      <%= link_to "Clear", entities_path(type: @type), class: "btn btn-text" %>
    <% end %>
  </div>
  <details <%= "open" if extra_filters.positive? %>>
    <summary class="w-fit cursor-pointer text-sm text-ink-soft">
      Tags and sort<%= " · #{extra_filters} in use" if extra_filters.positive? %>
    </summary>
    <div class="flex flex-wrap items-end gap-4 mt-3">
      <div class="flex-1 min-w-[180px]">
        <label for="entities-tags" class="block text-sm font-medium mb-1 text-ink">Tags</label>
        <input type="text" id="entities-tags" name="tags" value="<%= @filters[:tags] %>" placeholder="<%= hint_placeholder(:entity_filter, :tags) %>" aria-describedby="entities-tags-hint" class="field-input font-mono text-sm" />
        <%= field_hint(:entity_filter, :tags, id: "entities-tags-hint", quiet: true) %>
      </div>
      <div>
        <label for="entities-sort" class="block text-sm font-medium mb-1 text-ink">Sort</label>
        <select id="entities-sort" name="sort" class="field-input" aria-describedby="<%= hint_describedby(:entity_filter, :sort) %>">
          <% [["Updated (newest)", "-updated_at"], ["Updated (oldest)", "updated_at"],
              ["Created (newest)", "-created_at"], ["Created (oldest)", "created_at"],
              ["Name (A–Z)", "name"], ["Name (Z–A)", "-name"]].each do |label, value| %>
            <option value="<%= value %>" <%= "selected" if @filters[:sort] == value %>><%= label %></option>
          <% end %>
        </select>
        <%= field_hint(:entity_filter, :sort, quiet: true) %>
      </div>
    </div>
  </details>
<% end %>

<% if @entities.empty? %>
  <%# Three different empties: never synced, synced but none of this type,
      or a filter that matches nothing. Each says what to do next. %>
  <% type_name = entity_type_label(@type).downcase %>
  <% if @synced_at.nil? %>
    <%= empty_state(:"entities.never_synced", type: type_name) do %>
      <%= button_to "Sync now", sync_entities_path(type: @type), method: :post, class: "btn-sm btn-text" %>
    <% end %>
  <% elsif filtered %>
    <%= empty_state(:"entities.no_match", type: type_name) do %>
      <%= link_to "Clear the filter", entities_path(type: @type), class: "btn btn-secondary" %>
      <%= button_to "Sync now", sync_entities_path(type: @type), method: :post, class: "btn-sm btn-text" %>
    <% end %>
  <% else %>
    <%= empty_state(:"entities.none", type: type_name) do %>
      <%= button_to "Sync now", sync_entities_path(type: @type), method: :post, class: "btn-sm btn-text" %>
    <% end %>
  <% end %>
<% else %>
  <p id="entities-count" role="status" aria-atomic="true" class="text-xs mb-2 text-ink-faint"><%= render "count" %></p>

  <%# A real table to assistive technology (role="table", rows, column headers,
      cells) that stays a CSS grid to the eye. The wrapper scrolls sideways on a
      narrow screen; each row's name link is focusable, so the scroll is reachable
      from the keyboard. %>
  <div class="overflow-x-auto panel entity-table" role="table" aria-label="<%= entity_type_label(@type) %>">
    <div style="--entity-cols: <%= entity_table_grid_columns(@type) %>; min-width: <%= entity_table_min_width(@type) %>">
      <div role="rowgroup">
        <div class="entity-row entity-row--head" role="row">
          <% entity_table_headers(@type).each do |label| %>
            <span class="section-label" role="columnheader"><%= label %></span>
          <% end %>
        </div>
      </div>
      <div id="entities-list" role="rowgroup">
        <%= render partial: "entity_row", collection: @entities, as: :entity, locals: { type: @type } %>
      </div>
    </div>
  </div>

  <%= render "pagination" %>
<% end %>
