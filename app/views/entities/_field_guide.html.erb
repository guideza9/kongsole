<%# entities/_field_guide — beside a JSON editor, what each field of this type
    is for (hints.fields.<type>) and, collapsed, the schema this Kong node
    reports (@schema_fields, Kong::EntitySchema). With no hints and no schema
    there is nothing to show, so nothing is rendered. %>
<% guide = I18n.exists?("hints.fields.#{entity_type}") ? I18n.t("hints.fields.#{entity_type}").keys : [] %>
<% if guide.any? || schema_fields.present? %>
  <section class="panel field-guide-panel" aria-labelledby="field-guide-heading">
    <h2 id="field-guide-heading" class="section-label mb-3">Field guide</h2>
    <% if guide.any? %>
      <dl class="field-guide">
        <% guide.each do |field| %>
          <div>
            <dt class="font-mono text-xs font-semibold text-ink"><%= field %></dt>
            <dd><%= field_hint(entity_type, field, id: nil) %></dd>
          </div>
        <% end %>
      </dl>
    <% end %>
    <% if schema_fields.present? %>
      <details class="disclosure <%= "mt-4" if guide.any? %>">
        <summary class="text-sm text-ink-soft">Every field Kong accepts here</summary>
        <div class="mt-3">
          <%= render "shared/schema_reference", fields: schema_fields %>
        </div>
      </details>
    <% end %>
  </section>
<% end %>
