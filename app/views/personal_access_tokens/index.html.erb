<% content_for :title, "Tokens" %>

<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="page-title">Personal access tokens</h1>
    <p class="text-sm mt-0.5 text-ink-soft"><%= t("hints.pages.tokens_index.intro") %> A token only reaches connections with a stored credential.</p>
  </div>
  <%= link_to "Issue a token", new_personal_access_token_path, class: "btn-primary btn" %>
</div>

<% if flash[:new_token] %>
  <%= render layout: "shared/notice", locals: { tone: :warning, role: "status", class: "mb-6" } do %>
    <p class="font-semibold text-warning">Copy this token now — it won't be shown again.</p>
    <p class="text-sm font-mono mt-1 break-all text-ink"><%= flash[:new_token] %></p>
  <% end %>
<% end %>

<% if @tokens.empty? %>
  <%= empty_state(:tokens) %>
<% else %>
  <div class="panel">
    <% @tokens.each do |token| %>
      <div class="flex items-start gap-3 px-4 py-3 border-b border-border">
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <span class="font-mono text-sm font-semibold text-ink"><%= token.token_prefix %>···</span>
            <% if token.name.present? %><span class="tag"><%= token.name %></span><% end %>
            <% if token.revoked? %>
              <%= status_badge("revoked") %>
              <span class="text-xs text-ink-soft"><%= plan_timestamp(token.revoked_at) %></span>
            <% end %>
          </div>
          <p class="text-xs mt-1 text-ink-soft">
            operator <%= token.operator %> · issued by <%= token.issued_by_username %> · <%= plan_timestamp(token.created_at) %>
            · last used <%= plan_timestamp(token.last_used_at) || "never" %>
          </p>
          <div class="mt-1.5 flex flex-wrap gap-1.5">
            <% token.kong_connections.each do |connection| %>
              <span class="tag"><%= connection.name %></span>
            <% end %>
          </div>
        </div>
        <% unless token.revoked? %>
          <%= button_to "Revoke", revoke_personal_access_token_path(token), method: :post, class: "btn-text-danger btn-sm shrink-0 bg-transparent",
                form: { data: { turbo_confirm: "Revoke this token? Anything using it stops working immediately." } } %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
