<% content_for :title, "Trace a request · #{@project.name}" %>
<%# R5.8: one request's journey through this project's Kong, as this machine
    last synced it (Kong::RequestTrace) -- the request, the route that
    catches it, the plugins that run, and what the service receives. Each
    stop explains only its own settings. No login and no call to Kong. %>
<p class="page-back"><%= link_to @project.name, project_path(@project.key) %></p>
<h1 class="page-title">Trace a request</h1>
<p class="trace-intro"><%= t("hints.pages.project_trace.intro") %></p>

<%= render "project_traces/form" %>

<% if @trace %>
  <ol class="trace-stops">
    <%= render "project_traces/request_stop" %>
    <%= render "project_traces/route_stop" %>
    <% if @trace.match.route %>
      <%= render "project_traces/plugins_stop" %>
      <%= render "project_traces/service_stop" %>
    <% end %>
  </ol>
  <%= render "project_traces/folds" %>
<% end %>
