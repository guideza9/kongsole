<%# shared/_field_hint — a field's help, an example value, and (detailed hints
    only) a longer note. The id is the input's aria-describedby target, so a
    screen reader hears the help with the label. See HintsHelper#field_hint. %>
<% screen_reader_only = local_assigns[:screen_reader_only] %>
<%= tag.div id: id.presence, class: [ "field-hint", ("sr-only" if screen_reader_only) ] do %>
  <p><%= help %><% if example && !screen_reader_only %> <span class="field-hint__example"><%= t("hints.ui.example_prefix") %> <code><%= example %></code></span><% end %></p>
  <% if detail %>
    <p class="field-hint__detail"><%= detail %></p>
  <% end %>
<% end %>
