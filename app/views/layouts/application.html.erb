<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Kongsole" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Kongsole">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="font-sans">
    <%= link_to "Skip to content", "#main", class: "skip-link" %>

    <header class="topbar <%= content_for(:env_tone) || current_connection&.env_tone %> px-4 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-x-6 gap-y-1 sm:sticky sm:top-0 z-10">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-1">
        <%= link_to "Kongsole", root_path, class: "wordmark text-[15px] whitespace-nowrap" %>
        <nav aria-label="Primary" class="flex flex-wrap items-center gap-x-1 text-sm text-ink-soft">
          <%= nav_link_to "Connections", connections_path, current: primary_nav_current?(:connections), class: "topbar-action hover:text-ink transition-colors" %>
          <% if signed_in? %>
            <%= nav_link_to "Entities", entities_path, current: primary_nav_current?(:entities), class: "topbar-action hover:text-ink transition-colors" %>
            <%= nav_link_to "Pending PRs", change_plans_path, current: primary_nav_current?(:pending), class: "topbar-action hover:text-ink transition-colors" %>
            <%= nav_link_to "Audit", audit_events_path, current: primary_nav_current?(:audit), class: "topbar-action hover:text-ink transition-colors" %>
            <%= nav_link_to "Tokens", personal_access_tokens_path, current: primary_nav_current?(:tokens), class: "topbar-action hover:text-ink transition-colors" %>
          <% end %>
          <%= nav_link_to "Health", health_path, current: primary_nav_current?(:health), class: "topbar-action hover:text-ink transition-colors" %>
        </nav>
      </div>
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 text-sm">
        <% if signed_in? %>
          <%= env_badge(current_connection, size: :lg) %>
          <% if current_connection.read_only? %>
            <span class="tag text-xs uppercase tracking-wide">read-only</span>
          <% end %>
          <% if current_connection.shared_credential? %>
            <span class="text-xs sm:text-sm text-ink-soft">shared credential — as <%= current_operator %></span>
          <% end %>
        <% end %>
        <%= render "shared/hint_toggle" %>
        <% if signed_in? %>
          <%= render "shared/env_switcher" %>
          <%= button_to "Sign out", logout_path, method: :delete, class: "btn-text topbar-action" %>
        <% end %>
      </div>
    </header>

    <main id="main" tabindex="-1" class="w-full max-w-5xl mx-auto mt-8 px-4 sm:px-6 pb-16">
      <%# A flash arrives with the page, so its live region already holds the
          text by the time a screen reader reaches it and nothing is announced.
          The flash controller re-inserts the text a frame later, into a region
          that is by then established and empty -- which is the change a live
          region reports. Without JS the banner simply stays as rendered. %>
      <% if notice %>
        <%= render layout: "shared/notice", locals: { tone: :success, role: "status", tag: :p, class: "mb-6", data: { controller: "flash" } } do %><%= notice %><% end %>
      <% end %>
      <% if alert && flash[:error_explanation].present? %>
        <%# R3: why it failed and what to do, in the same banner and live region. %>
        <%= render layout: "shared/notice", locals: { tone: :danger, role: "alert", class: "mb-6", data: { controller: "flash" } } do %><p><%= alert %></p><%= render "shared/error_explanation", explanation: flash[:error_explanation] %><% end %>
      <% elsif alert %>
        <%= render layout: "shared/notice", locals: { tone: :danger, role: "alert", tag: :p, class: "mb-6", data: { controller: "flash" } } do %><%= alert %><% end %>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
