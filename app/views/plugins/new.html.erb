<% content_for :title, @plugin_name ? "Add #{@plugin_name}" : "Add plugin" %>
<%# The scope the flow was entered with, as the plugin list shows it. From
    the catalog with no scope, the config step's picker chooses one. %>
<% entered_scope = { kind: @scope_type || "global", name: @scope_label.to_s.delete_prefix("#{@scope_type}: ") } %>

<p class="page-back"><%= link_to "Plugins", entities_path(type: "plugin") %></p>
<div class="plugins-head">
  <h1 class="page-title"><%= @plugin_name ? "Add #{@plugin_name}" : "Add plugin" %></h1>
  <% if @scope_type.present? %>
    <p class="plugins-head__scope"><span class="text-ink-soft">Adds to</span> <%= render "entities/scope", scope: entered_scope %></p>
  <% end %>
</div>
<% if (lede = page_lede("hints.pages.plugins_new.intro")) %><p class="text-sm mt-1 text-ink-soft max-w-2xl"><%= lede %></p><% end %>

<% if @catalog %>
  <%# Step 1: pick a plugin -- what this node loaded, the team's own apart
      from Kong's (Kong::PluginCatalog). %>
  <div class="mt-6">
    <% if @catalog.empty? %>
      <%= empty_state(:plugins_catalog) %>
    <% else %>
      <%= render "catalog", catalog: @catalog, scope_type: @scope_type, scope_kong_id: @scope_kong_id %>
    <% end %>
  </div>
<% else %>
  <%# Step 2: the config form, built from this plugin's schema on this
      connection (Kong::PluginSchemaForm). %>
  <div class="max-w-4xl grid gap-4 mt-6">
    <% @schema_mismatch.to_a.each do |mismatch| %>
      <%= render layout: "shared/notice", locals: { tone: :warning, tag: :p, class: "text-xs" } do %>
        Schema differs on <%= mismatch[:env] %> (Kong <%= mismatch[:kong_version] %>)
      <% end %>
    <% end %>

    <% if @form_error.present? %>
      <%= render layout: "shared/notice", locals: { tone: :danger, role: "alert", tag: :p, class: "text-xs" } do %>
        <%= @form_error %>
      <% end %>
    <% end %>

    <% if @fields.present? %>
      <%= form_with url: plugins_path, method: :post, class: "panel p-4 grid gap-3" do %>
        <input type="hidden" name="plugin_name" value="<%= @plugin_name %>" />
        <% if @scope_options %>
          <%= render "scope_picker", options: @scope_options, selected: params[:scope] %>
        <% else %>
          <input type="hidden" name="scope_type" value="<%= @scope_type %>" />
          <input type="hidden" name="scope_kong_id" value="<%= @scope_kong_id %>" />
        <% end %>

        <% @fields.each do |field| %>
          <% value = @values.to_h[field.name] %>
          <% input_name = "plugin[config][#{field.name}]" %>
          <label class="grid gap-1 text-sm">
            <span class="font-mono font-semibold"><%= field.name %><%= " (required)" if field.required %></span>
            <% case field.kind %>
            <% when :enum %>
              <select name="<%= input_name %>">
                <option value="">Default<%= ": #{field.default}" unless field.default.nil? %></option>
                <% field.one_of.each do |option| %>
                  <option value="<%= option %>" <%= "selected" if value.to_s == option.to_s %>><%= option %></option>
                <% end %>
              </select>
            <% when :boolean %>
              <input type="hidden" name="<%= input_name %>" value="0" />
              <input type="checkbox" name="<%= input_name %>" value="1" <%= "checked" if (value.nil? ? field.default : value.to_s == "1") %> />
            <% when :list, :json %>
              <textarea name="<%= input_name %>" rows="3" spellcheck="false" <%= 'autocomplete="off"'.html_safe if field.secret %>><%= value unless field.secret %></textarea>
            <% else %>
              <% if field.secret %>
                <input type="password" name="<%= input_name %>" autocomplete="off" />
              <% else %>
                <input type="text" name="<%= input_name %>" value="<%= value %>" placeholder="<%= "Default: #{field.default}" unless field.default.nil? %>" />
              <% end %>
            <% end %>
            <% if field.help || field.description %>
              <span class="text-xs text-ink-soft"><%= field.help || field.description %></span>
            <% end %>
            <% Array(@field_errors[field.path]).each do |message| %>
              <span class="text-xs text-danger" role="alert"><%= field.path %>: <%= message %></span>
            <% end %>
          </label>
        <% end %>

        <% unless @admin_path_scope %>
          <div class="flex gap-2">
            <button type="submit" class="btn-primary btn">Review change</button>
            <%= link_to "Back", new_plugin_path(scope_type: @scope_type, scope_kong_id: @scope_kong_id), class: "btn-sm btn-text" %>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <%# Advanced: the whole plugin as JSON, seeded from the schema's defaults,
        with a read-only reference panel built from the same schema. %>
    <details <%= "open" if @payload_error.present? || @fields.blank? %>>
      <summary class="text-sm font-semibold">Advanced: edit the whole plugin as JSON</summary>
      <div class="grid gap-4 sm:grid-cols-2 mt-3">
        <%= form_with url: plugins_path, method: :post, data: { controller: "json-editor" } do %>
          <input type="hidden" name="scope_type" value="<%= @scope_type %>" />
          <input type="hidden" name="scope_kong_id" value="<%= @scope_kong_id %>" />
          <input type="hidden" name="plugin_name" value="<%= @plugin_name %>" />

          <section class="panel p-4">
            <h2 id="json-editor-heading" class="section-label mb-3"><%= @plugin_name %> config</h2>
            <div id="json-editor-help" class="grid gap-2 mb-3">
              <% %i[scope enabled protocols].each do |field| %>
                <div>
                  <p class="text-xs font-mono font-semibold text-ink"><%= field %></p>
                  <%= field_hint(:plugin, field, id: nil) %>
                </div>
              <% end %>
            </div>

            <% if @payload_error.present? %>
              <%= render layout: "shared/notice", locals: { tone: :danger, role: "alert", tag: :p, class: "mb-3 text-xs" } do %>
                <%= @payload_error %>
              <% end %>
            <% end %>

            <div class="json-editor" data-json-editor-target="wrapper">
              <pre class="json-editor__highlight json-viewer" aria-hidden="true" data-json-editor-target="highlight"></pre>
              <textarea name="payload_json" rows="18" spellcheck="false" autocomplete="off"
                        aria-labelledby="json-editor-heading" aria-describedby="json-editor-help"
                        class="json-editor__textarea"
                        data-json-editor-target="input"
                        data-action="input->json-editor#validate scroll->json-editor#syncScroll"><%= @payload_json %></textarea>
            </div>

            <p role="status" class="text-xs mt-2 font-mono text-ink-faint" data-json-editor-target="status"></p>

            <div class="flex gap-2 mt-4">
              <button type="submit" class="btn-primary btn" data-json-editor-target="submit">Review change</button>
              <button type="button" class="btn-sm btn-secondary" data-action="json-editor#format">Format</button>
            </div>
          </section>
        <% end %>

        <section class="panel p-4">
          <h2 class="section-label mb-3">Schema reference</h2>
          <% if @schema %>
            <%= render "shared/schema_reference", fields: schema_rows(plugin_config_fields(@schema)) %>
          <% else %>
            <p class="text-sm text-ink-soft">Couldn't load the schema from Kong.</p>
          <% end %>
        </section>
      </div>
    </details>
  </div>
<% end %>
