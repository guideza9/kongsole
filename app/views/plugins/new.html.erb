<% content_for :title, @plugin_name ? "Add #{@plugin_name}" : "Add plugin" %>
<%# The scope the flow was entered with, as the plugin list shows it. From
    the catalog with no scope, the config step's picker chooses one. %>
<% entered_scope = { kind: @scope_type || "global", name: @scope_label.to_s.delete_prefix("#{@scope_type}: ") } %>

<p class="page-back"><%= link_to "Plugins", entities_path(type: "plugin") %></p>
<div class="plugins-head">
  <h1 class="page-title"><%= @plugin_name ? "Add #{@plugin_name}" : "Add plugin" %></h1>
  <% if @scope_type.present? %>
    <p class="plugins-head__scope"><span class="text-ink-soft">Adds to</span> <%= render "entities/scope", scope: entered_scope %></p>
  <% end %>
</div>
<% if (lede = page_lede("hints.pages.plugins_new.intro")) %><p class="text-sm mt-1 text-ink-soft max-w-2xl"><%= lede %></p><% end %>

<% if @catalog %>
  <%# Step 1: pick a plugin -- what this node loaded, the team's own apart
      from Kong's (Kong::PluginCatalog). %>
  <div class="mt-6">
    <% if @catalog.empty? %>
      <%= empty_state(:plugins_catalog) %>
    <% else %>
      <%= render "catalog", catalog: @catalog, scope_type: @scope_type, scope_kong_id: @scope_kong_id %>
    <% end %>
  </div>
<% else %>
  <%# Step 2: the config form, built from this plugin's schema on this
      connection (Kong::PluginSchemaForm). What must be decided comes first;
      everything with a default is folded, its default showing. Warnings sit
      above the form: a different schema on another env of the project, the
      PR-mode rule for secrets, an admin-path scope (then nothing submits). %>
  <% needed, folded = plugin_fields_split(@fields.to_a) %>
  <% values = @values.to_h %>
  <% errors = @field_errors.to_h %>
  <% pr = @secret_policy == :reference_required %>
  <div class="plugin-config mt-6">
    <% @schema_mismatch.to_a.each do |mismatch| %>
      <%= risk_notice(:schema_mismatch, env: mismatch[:env], version: mismatch[:kong_version]) %>
    <% end %>
    <% if @admin_path_scope %>
      <%= risk_notice(:plugin_admin_path) %>
    <% elsif pr && @fields.to_a.any? { |field| field.secret || field.nested_secrets.present? } %>
      <%= risk_notice(:plugin_secret_pr) %>
    <% end %>

    <% if @form_error.present? || errors.any? %>
      <%= render layout: "shared/notice", locals: { tone: :danger, role: "alert", class: "text-sm" } do %>
        <% if @form_error.present? %><p class="font-medium"><%= @form_error %></p><% end %>
        <% if errors.any? %>
          <p class="font-medium"><%= t("hints.pages.plugins_new.form_errors", count: pluralize(errors.size, "problem")) %></p>
          <ul class="mt-1 list-disc pl-5">
            <% @fields.select { errors[_1.path] }.each do |field| %>
              <li><a href="#<%= plugin_field_id(field) %>" class="font-mono"><%= field.path %></a>: <%= errors[field.path].to_sentence %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    <% end %>

    <% if @fields.present? %>
      <%= form_with url: plugins_path, method: :post, class: "plugin-form" do %>
        <input type="hidden" name="plugin_name" value="<%= @plugin_name %>">
        <% if @scope_options %>
          <section class="panel plugin-form__section">
            <%= render "scope_picker", options: @scope_options, selected: params[:scope] %>
          </section>
        <% else %>
          <input type="hidden" name="scope_type" value="<%= @scope_type %>">
          <input type="hidden" name="scope_kong_id" value="<%= @scope_kong_id %>">
        <% end %>

        <% if needed.any? %>
          <section class="panel plugin-form__section" aria-labelledby="plugin-needed">
            <h2 id="plugin-needed" class="section-label">Config</h2>
            <div class="plugin-form__fields">
              <% needed.each do |field| %>
                <%= render(field.secret ? "secret_field" : "field", field: field, values: values, errors: errors,
                      plugin_name: @plugin_name, secret_policy: @secret_policy) %>
              <% end %>
            </div>
          </section>
        <% end %>

        <% if folded.any? %>
          <details class="disclosure plugin-defaults panel" <%= "open" if needed.empty? || folded.any? { plugin_field_attention?(_1, values, errors) } %>>
            <summary><%= t("hints.pages.plugins_new.defaults_summary", count: folded.size) %></summary>
            <div class="plugin-defaults__body">
              <p class="text-sm text-ink-soft"><%= t("hints.pages.plugins_new.defaults_body") %></p>
              <div class="plugin-form__fields">
                <% folded.each do |field| %>
                  <%= render "field", field: field, values: values, errors: errors, plugin_name: @plugin_name, secret_policy: @secret_policy %>
                <% end %>
              </div>
            </div>
          </details>
        <% end %>

        <section class="panel plugin-form__section" aria-labelledby="plugin-meta">
          <h2 id="plugin-meta" class="section-label">Plugin</h2>
          <div class="plugin-form__fields">
            <div class="plugin-field plugin-field--switch">
              <input type="hidden" name="plugin[enabled]" value="0">
              <input type="checkbox" id="plugin-enabled" name="plugin[enabled]" value="1" class="plugin-field__switch"
                     <%= "checked" if params.dig(:plugin, :enabled).nil? || params.dig(:plugin, :enabled) == "1" %>
                     aria-describedby="hint-plugin-enabled">
              <label for="plugin-enabled" class="plugin-field__label"><span class="plugin-field__name">enabled</span></label>
              <%= field_hint(:plugin, :enabled, id: "hint-plugin-enabled") %>
            </div>
            <div class="plugin-field">
              <label for="plugin-tags" class="plugin-field__label"><span class="plugin-field__name">tags</span></label>
              <input type="text" id="plugin-tags" name="plugin[tags]" value="<%= params.dig(:plugin, :tags) %>" spellcheck="false" autocapitalize="off"
                     class="field-input plugin-field__control font-mono" placeholder="<%= hint_placeholder(:plugin, :tags_list) %>"
                     aria-describedby="hint-plugin-tags-list">
              <% if current_connection.select_tags.present? %>
                <p class="plugin-field__hint">Always added: <% current_connection.select_tags.each do |tag| %><code class="font-mono text-ink"><%= tag %></code> <% end %></p>
              <% end %>
              <%= field_hint(:plugin, :tags_list, id: "hint-plugin-tags-list", quiet: true) %>
            </div>
          </div>
        </section>

        <% unless @admin_path_scope %>
          <div class="plugin-form__actions">
            <button type="submit" class="btn btn-primary">Review change</button>
            <%= link_to "Back to the list", new_plugin_path(scope_type: @scope_type, scope_kong_id: @scope_kong_id), class: "btn-sm btn-text" %>
          </div>
        <% end %>
      <% end %>
    <% end %>

    <%# Advanced: the whole plugin as JSON, seeded from the schema's defaults,
        with a read-only reference panel built from the same schema. %>
    <details class="disclosure plugin-advanced" <%= "open" if @payload_error.present? || @fields.blank? %>>
      <summary>Advanced: edit the whole plugin as JSON</summary>
      <div class="grid gap-4 sm:grid-cols-2 mt-3">
        <% unless @admin_path_scope %>
        <%= form_with url: plugins_path, method: :post, data: { controller: "json-editor" } do %>
          <input type="hidden" name="scope_type" value="<%= @scope_type %>" />
          <input type="hidden" name="scope_kong_id" value="<%= @scope_kong_id %>" />
          <input type="hidden" name="plugin_name" value="<%= @plugin_name %>" />

          <section class="panel p-4">
            <h2 id="json-editor-heading" class="section-label mb-3"><%= @plugin_name %> config</h2>
            <div id="json-editor-help" class="grid gap-2 mb-3">
              <% %i[scope enabled protocols].each do |field| %>
                <div>
                  <p class="text-xs font-mono font-semibold text-ink"><%= field %></p>
                  <%= field_hint(:plugin, field, id: nil) %>
                </div>
              <% end %>
            </div>

            <% if @payload_error.present? %>
              <%= render layout: "shared/notice", locals: { tone: :danger, role: "alert", tag: :p, class: "mb-3 text-xs" } do %>
                <%= @payload_error %>
              <% end %>
            <% end %>

            <div class="json-editor" data-json-editor-target="wrapper">
              <pre class="json-editor__highlight json-viewer" aria-hidden="true" data-json-editor-target="highlight"></pre>
              <textarea name="payload_json" rows="18" spellcheck="false" autocomplete="off"
                        aria-labelledby="json-editor-heading" aria-describedby="json-editor-help"
                        class="json-editor__textarea"
                        data-json-editor-target="input"
                        data-action="input->json-editor#validate scroll->json-editor#syncScroll"><%= @payload_json %></textarea>
            </div>

            <p role="status" class="text-xs mt-2 font-mono text-ink-faint" data-json-editor-target="status"></p>

            <div class="flex gap-2 mt-4">
              <button type="submit" class="btn-primary btn" data-json-editor-target="submit">Review change</button>
              <button type="button" class="btn-sm btn-secondary" data-action="json-editor#format">Format</button>
            </div>
          </section>
        <% end %>
        <% end %>

        <section class="panel p-4">
          <h2 class="section-label mb-3">Schema reference</h2>
          <% if @schema %>
            <%= render "shared/schema_reference", fields: schema_rows(plugin_config_fields(@schema)) %>
          <% else %>
            <p class="text-sm text-ink-soft">Couldn't load the schema from Kong.</p>
          <% end %>
        </section>
      </div>
    </details>
  </div>
<% end %>
