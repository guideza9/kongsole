<%# R4.7: a field the plugin's schema marks secret (encrypted/referenceable).
    Masked, never filled -- not from Kong, not from what was typed before a
    re-render -- and it suggests a vault reference named after the plugin and
    field. PR mode refuses a plain value (Kong::PluginSecretPolicy); direct
    mode takes one but still suggests the reference. A secret that is a map
    or list (http-log's headers) is JSON, still never filled. %>
<% id = plugin_field_id(field) %>
<% error = errors[field.path].presence %>
<% ref = plugin_vault_example(plugin_name, field) %>
<% describedby = [ plugin_field_hint_id(field), (plugin_field_error_id(field) if error) ].compact.join(" ") %>
<% name = "plugin[config][#{field.name}]" %>

<div class="plugin-field plugin-field--secret">
  <label for="<%= id %>" class="plugin-field__label">
    <span class="plugin-field__name"><%= field.name %></span>
    <span class="tag plugin-field__secret"><%= render "shared/lock_icon" %> Secret</span>
    <% if field.required %><span class="tag plugin-field__required">Required</span><% end %>
  </label>

  <% if field.kind == :json || field.kind == :list %>
    <textarea id="<%= id %>" name="<%= name %>" rows="3" spellcheck="false" autocapitalize="off" autocomplete="off"
              class="field-input plugin-field__control font-mono"
              aria-describedby="<%= describedby %>" <%= 'aria-invalid="true"'.html_safe if error %>></textarea>
  <% else %>
    <input type="password" id="<%= id %>" name="<%= name %>" autocomplete="off" spellcheck="false" autocapitalize="off"
           class="field-input plugin-field__control font-mono" placeholder="<%= t("hints.ui.example_prefix") %> <%= ref[:example] %>"
           aria-describedby="<%= describedby %>" <%= 'aria-invalid="true"'.html_safe if error %>>
  <% end %>

  <% if error %>
    <p id="<%= plugin_field_error_id(field) %>" class="field-error"><%= error.to_sentence %></p>
  <% end %>
  <div id="<%= plugin_field_hint_id(field) %>" class="plugin-field__hint">
    <% if (text = field.help.presence || field.description.presence) %><p><%= text %></p><% end %>
    <p><%= t(secret_policy == :reference_required ? "hints.fields.plugin.secret_pr" : "hints.fields.plugin.secret_direct",
             example: ref[:example], env_var: ref[:env_var], deck: ref[:deck]) %></p>
  </div>
</div>
