  "recorded_at": "2026-09-26T19:09:05Z",
  "cases": [
    {
      "name": "longer prefix wins",
      "request": {
        "method": "GET",
        "host": "o0.r5.test",
        "path": "/api/v1/x"
      },
      "routes": [
        {
          "name": "short",
          "paths": [
            "/api"
          ]
        },
        {
          "name": "long",
          "paths": [
            "/api/v1"
          ]
        }
      ],
      "got": {
        "status": 200,
        "route": "long"
      }
    },
    {
      "name": "a prefix is a plain string prefix",
      "request": {
        "method": "GET",
        "host": "o1.r5.test",
        "path": "/billingx"
      },
      "routes": [
        {
          "name": "billing",
          "paths": [
            "/billing"
          ]
        }
      ],
      "got": {
        "status": 200,
        "route": "billing"
      }
    },
    {
      "name": "more conditions win",
      "request": {
        "method": "GET",
        "host": "o2.r5.test",
        "path": "/api"
      },
      "routes": [
        {
          "name": "paths-only",
          "paths": [
            "/api"
          ]
        },
        {
          "name": "with-method",
          "paths": [
            "/api"
          ],
          "methods": [
            "GET"
          ]
        }
      ],
      "got": {
        "status": 200,
        "route": "with-method"
      }
    },
    {
      "name": "regex against prefix",
      "request": {
        "method": "GET",
        "host": "o3.r5.test",
        "path": "/api/v2"
      },
      "routes": [
        {
          "name": "prefix",
          "paths": [
            "/api"
          ]
        },
        {
          "name": "regex",
          "paths": [
            "~/api/v[0-9]+$"
          ]
        }
      ],
      "got": {
        "status": 200,
        "route": "regex"
      }
    },
    {
      "name": "higher regex_priority wins",
      "request": {
        "method": "GET",
        "host": "o4.r5.test",
        "path": "/api/v2"
      },
      "routes": [
        {
          "name": "rx-low",
          "paths": [
            "~/api/v\\d"
          ],
          "regex_priority": 0
        },
        {
          "name": "rx-high",
          "paths": [
            "~/api/v2"
          ],
          "regex_priority": 5
        }
      ],
      "got": {
        "status": 200,
        "route": "rx-high"
      }
    },
    {
