          ],
          "paths": [
            "/x"
          ]
        },
        {
          "name": "exact",
          "hosts": [
            "api.o6.r5.test"
          ],
          "paths": [
            "/x"
          ]
        }
      ],
      "got": {
        "status": 200,
        "route": "exact"
      }
    },
